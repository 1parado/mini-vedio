{
  "_说明": "bubblewrap init 生成 twa-manifest.json 后，可对照本示例核对推荐取值。包名与域名按实际托管地址修改。",
  "packageId": "com.example.minivedio",
  "host": "example.org",
  "name": "mini-vedio",
  "launcherName": "mini-vedio",
  "appVersionName": "0.1.0",
  "appVersionCode": 1,
  "useBrowserStack": false,
  "webManifestUrl": "https://example.org/manifest.webmanifest",
  "shortcuts": [],
  "display": "standalone",
  "themeColor": "#111111",
  "themeColorDark": "#111111",
  "navigationColor": "#111111",
  "navigationColorDark": "#111111",
  "navigationDividerColor": "#111111",
  "navigationDividerColorDark": "#111111",
  "backgroundColor": "#111111",
  "enableNotifications": false,
  "enableSiteSettingsShortcut": true,
  "isChromeOSOnly": false,
  "isMetaQuest": false,
  "fullScopeUrl": "https://example.org/",
  "minSdkVersion": 21,
  "orientation": "default",
  "fallbackType": "customtabs",
  "features": {
    "locationDelegation": { "enabled": false },
    "playBilling": { "enabled": false }
  },
  "alphaDependencies": { "enabled": false },
  "enableWideColorGamut": false,
  "splashScreenFadeOutDuration": 300
}
